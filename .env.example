# --- Required ---
# Postgres connection string. Supabase: Project Settings → Database → Connection string (URI, "Session pooler").
DATABASE_URL=postgres://user:password@host:5432/postgres
# Long random string. Hostinger's cron job sends it to /api/cron.
CRON_SECRET=change-me-to-a-long-random-string

# --- DataForSEO (one account covers every API) ---
# API login and password from https://app.dataforseo.com/api-access (not your website password).
# Leave blank to run in demo mode with simulated answers.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Optional model overrides for the LLM Responses engines.
DATAFORSEO_PERPLEXITY_MODEL=sonar
DATAFORSEO_CLAUDE_MODEL=claude-sonnet-4-0

# --- Optional ---
# This email always gets staff (admin) access when it signs up. The first account ever created is staff too.
ADMIN_EMAIL=
# Checks processed in parallel per batch.
TRACKING_CONCURRENCY=6
# Enables the AI visibility section of the free public audit on the homepage.
ANTHROPIC_API_KEY=
