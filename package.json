{
  "name": "aeogrowthleads",
  "version": "0.1.0",
  "private": true,
  "description": "AEOGrowthLeads: AI visibility tracking, AEO audits and done-for-you delivery.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/migrate.mjs && next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "audit": "tsx scripts/audit.ts",
    "stripe:setup": "node scripts/stripe-setup.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.6",
    "nodemailer": "^10.0.11",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9"
  },
  "engines": {
    "node": ">=20.9"
  }
}
